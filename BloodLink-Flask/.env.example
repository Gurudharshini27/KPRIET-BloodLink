# Copy to .env and fill in. Never commit .env.
PORT=5000
DATABASE_FILE=database/bloodlink.db

# Resend (https://resend.com): create an API key, then set a sender.
# onboarding@resend.dev works for testing, but only delivers to YOUR OWN Resend account email.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Any long random string, e.g.  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_string
